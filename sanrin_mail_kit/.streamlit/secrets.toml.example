# このファイルをコピーして使う例（中身は実値に差し替え）
# ローカル:  .streamlit/secrets.toml  （gitignore 済み）
# クラウド:  Streamlit Cloud の Secrets 設定画面に同じ内容を貼る

# 社内公開用パスワード（必須・クラウドでは必ず設定）
app_password = "ここに強いパスワード"

# Google サービスアカウント JSON の中身を、キーごとに書く
# （data/google_service_account.json の各項目）
[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "sanrin-mail-kit@your-project.iam.gserviceaccount.com"
client_id = "..."
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/..."
universe_domain = "googleapis.com"
